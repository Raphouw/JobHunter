{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "framework": "vite",
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build:cloud",
  "outputDirectory": "web/dist-cloud",
  "functions": {
    "api/scan.py": {
      "maxDuration": 300,
      "includeFiles": "{stage_hunter.py,connectors.py,regions.py,site_configs.py,site_network.py,cloud/scan_worker.py,cloud/offer_history.py,config/**,web/public/cities/*.json}",
      "excludeFiles": "{credentials/**,output/**,web/src/**,web/node_modules/**,web/dist/**,web/dist-cloud/**,web/.env*,web/package*,web/index.html,tests/**,logs/**,*.sqlite3,*.xlsx,*.log}"
    },
    "api/sites.py": {
      "maxDuration": 60,
      "includeFiles": "{cloud/scan_worker.py,cloud/offer_history.py,site_configs.py,site_network.py}"
    }
  },
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/|cities/).*)", "destination": "/index.html" }
  ]
}
