# Pour un serveur accessible sur le réseau, définir ces valeurs et placer
# un proxy HTTPS devant l'application. Ne jamais publier le port directement.
STAGE_HUNTER_HOST=127.0.0.1
STAGE_HUNTER_PORT=8501
STAGE_HUNTER_WEB_USER=
STAGE_HUNTER_WEB_PASSWORD=

# Google reste facultatif pour chaque profil.
GOOGLE_SHEET_ID=
GOOGLE_RESPONSE_TAB=Réponses
GOOGLE_OPPORTUNITY_TAB=Opportunités

# Réglages généraux. L'interface adapte automatiquement ces valeurs au mode choisi.
SEARCH_QUERY_BUDGET=45
SEARCH_RESULTS_PER_QUERY=8
SEARCH_WORKERS=6
SCRAPE_WORKERS=8
FIXED_SITE_LIMIT=16
LISTING_CRAWL_DEPTH=2
MAX_RECURSIVE_LEADS=160
MAX_TOTAL_DETAIL_PAGES=800
# Le mode Exhaustif 1h remplace automatiquement ces valeurs pendant son scan.
MAX_LISTING_DETAILS=45
MAX_LEADS_PER_SUBLISTING=24
MAX_IN_FLIGHT_PAGES=16
MAX_RESPONSE_BYTES=4000000
MAX_DIAGNOSTIC_LISTING_LEADS=3000
SEARCH_ROLE_PAIR_LIMIT=3
SEARCH_INTENT_EXPANSION=0
SEARCH_SOURCE_QUERIES_PER_DOMAIN=1
WEB_DISABLE_CIRCUIT_BREAKER=0
WEB_RETRY_EMPTY_RESULTS=0
SCAN_TIME_BUDGET_SECONDS=0
SCAN_DEADLINE_RESERVE_SECONDS=120
SEARCH_BACKENDS=duckduckgo,yahoo
# Vide = région calculée automatiquement depuis le pays du profil (ch-fr, fr-fr, de-de…).
SEARCH_REGION=
SEARCH_TIMEOUT_SECONDS=8
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=1
MIN_OPPORTUNITY_SCORE=30
MAX_JOB_AGE_DAYS=90
GMAIL_EXCLUDED_LABELS=STAGE
GMAIL_LOOKBACK_DAYS=120
